[{"id":312,"category":"time","en":"Today","hi":"आज","mr":"आज","mr_roman":"aaj","example":{"mr":"आज रविवार आहे.","roman":"Aaj ravivar aahe.","en":"Today is Sunday."}},{"id":313,"category":"time","en":"Tomorrow","hi":"कल (आने वाला)","mr":"उद्या","mr_roman":"udya","example":{"mr":"उद्या भेटू.","roman":"Udya bhetu.","en":"Let's meet tomorrow."}},{"id":314,"category":"time","en":"Yesterday","hi":"कल (बीता हुआ)","mr":"काल","mr_roman":"kaal","example":{"mr":"काल पाऊस पडला.","roman":"Kaal paus padla.","en":"It rained yesterday."}},{"id":315,"category":"time","en":"Now","hi":"अभी","mr":"आता","mr_roman":"aata","example":{"mr":"आता जेवायला चल.","roman":"Aata jevayla chal.","en":"Come to eat now."}},{"id":316,"category":"time","en":"Morning","hi":"सुबह","mr":"सकाळ","mr_roman":"sakal","example":{"mr":"सकाळी लवकर ऊठ.","roman":"Sakali lavkar uth.","en":"Wake up early in the morning."}},{"id":317,"category":"time","en":"Afternoon","hi":"दोपहर","mr":"दुपार","mr_roman":"dupar","example":{"mr":"दुपारी ऊन असतं.","roman":"Dupari unh asta.","en":"It is sunny in the afternoon."}},{"id":318,"category":"time","en":"Evening","hi":"शाम","mr":"संध्याकाळ","mr_roman":"sandhyakal","example":{"mr":"संध्याकाळी फिरायला जाऊ.","roman":"Sandhyakali phirayla jau.","en":"Let's go for a walk in the evening."}},{"id":319,"category":"time","en":"Night","hi":"रात","mr":"रात्र","mr_roman":"ratra","example":{"mr":"रात्री लवकर झोप.","roman":"Ratri lavkar jhop.","en":"Sleep early at night."}},{"id":320,"category":"time","en":"Day","hi":"दिन","mr":"दिवस","mr_roman":"divas","example":{"mr":"आज दिवस चांगला आहे.","roman":"Aaj divas changla aahe.","en":"Today is a good day."}},{"id":321,"category":"time","en":"Week","hi":"हफ़्ता","mr":"आठवडा","mr_roman":"aathavda","example":{"mr":"पुढच्या आठवड्यात ये.","roman":"Pudhchya aathavdyat ye.","en":"Come next week."}},{"id":322,"category":"time","en":"Month","hi":"महीना","mr":"महिना","mr_roman":"mahina","example":{"mr":"हा महिना संपला.","roman":"Ha mahina sampla.","en":"This month is over."}},{"id":323,"category":"time","en":"Year","hi":"साल","mr":"वर्ष","mr_roman":"varsh","example":{"mr":"नवीन वर्ष सुरू झालं.","roman":"Navin varsh suru jhala.","en":"The new year has started."}},{"id":324,"category":"time","en":"Hour","hi":"घंटा","mr":"तास","mr_roman":"taas","example":{"mr":"एक तास लागेल.","roman":"Ek taas lagel.","en":"It will take one hour."}},{"id":325,"category":"time","en":"Time","hi":"समय","mr":"वेळ","mr_roman":"vel","example":{"mr":"वेळ किती झाली?","roman":"Vel kiti jhali?","en":"What is the time?"}},{"id":326,"category":"time","en":"Minute","hi":"मिनट","mr":"मिनिट","mr_roman":"minit","example":{"mr":"दोन मिनिटं थांब.","roman":"Don minita thamb.","en":"Wait two minutes."}},{"id":327,"category":"time","en":"Sunday","hi":"रविवार","mr":"रविवार","mr_roman":"ravivar","example":{"mr":"रविवारी सुट्टी असते.","roman":"Ravivari sutti aste.","en":"There is a holiday on Sunday."}},{"id":328,"category":"time","en":"Monday","hi":"सोमवार","mr":"सोमवार","mr_roman":"somvar","example":{"mr":"सोमवारी शाळा सुरू होते.","roman":"Somvari shala suru hote.","en":"School starts on Monday."}},{"id":329,"category":"time","en":"Tuesday","hi":"मंगलवार","mr":"मंगळवार","mr_roman":"mangalvar","example":{"mr":"मंगळवारी बाजार भरतो.","roman":"Mangalvari bajar bharto.","en":"The market is held on Tuesday."}},{"id":330,"category":"time","en":"Wednesday","hi":"बुधवार","mr":"बुधवार","mr_roman":"budhvar","example":{"mr":"बुधवारी परीक्षा आहे.","roman":"Budhvari pariksha aahe.","en":"There is an exam on Wednesday."}},{"id":331,"category":"time","en":"Thursday","hi":"गुरुवार","mr":"गुरुवार","mr_roman":"guruvar","example":{"mr":"गुरुवारी उपवास असतो.","roman":"Guruvari upvas asto.","en":"There is a fast on Thursday."}},{"id":332,"category":"time","en":"Friday","hi":"शुक्रवार","mr":"शुक्रवार","mr_roman":"shukravar","example":{"mr":"शुक्रवारी सिनेमा बघू.","roman":"Shukravari cinema baghu.","en":"Let's watch a movie on Friday."}},{"id":333,"category":"time","en":"Saturday","hi":"शनिवार","mr":"शनिवार","mr_roman":"shanivar","example":{"mr":"शनिवारी अर्धा दिवस.","roman":"Shanivari ardha divas.","en":"Half day on Saturday."}},{"id":334,"category":"time","en":"Later","hi":"बाद में","mr":"नंतर","mr_roman":"nantar","example":{"mr":"नंतर बोलू.","roman":"Nantar bolu.","en":"Let's talk later."}},{"id":335,"category":"time","en":"Early","hi":"जल्दी","mr":"लवकर","mr_roman":"lavkar","example":{"mr":"लवकर ये.","roman":"Lavkar ye.","en":"Come early."}},{"id":336,"category":"time","en":"Late","hi":"देर","mr":"उशीर","mr_roman":"ushir","example":{"mr":"मला उशीर झाला.","roman":"Mala ushir jhala.","en":"I got late."}},{"id":337,"category":"time","en":"Always","hi":"हमेशा","mr":"नेहमी","mr_roman":"nehmi","example":{"mr":"तो नेहमी हसतो.","roman":"To nehmi hasto.","en":"He always smiles."}},{"id":338,"category":"time","en":"Sometimes","hi":"कभी-कभी","mr":"कधीकधी","mr_roman":"kadhikadhi","example":{"mr":"मी कधीकधी चहा पितो.","roman":"Mi kadhikadhi chaha pito.","en":"I sometimes drink tea."}},{"id":339,"category":"time","en":"Never","hi":"कभी नहीं","mr":"कधीच नाही","mr_roman":"kadhich nahi","example":{"mr":"मी कधीच खोटं बोलत नाही.","roman":"Mi kadhich khota bolat nahi.","en":"I never lie."}},{"id":340,"category":"time","en":"Daily","hi":"रोज़","mr":"रोज","mr_roman":"roj","example":{"mr":"मी रोज व्यायाम करतो.","roman":"Mi roj vyayam karto.","en":"I exercise daily."}},{"id":341,"category":"time","en":"Holiday","hi":"छुट्टी","mr":"सुट्टी","mr_roman":"sutti","example":{"mr":"उद्या सुट्टी आहे.","roman":"Udya sutti aahe.","en":"Tomorrow is a holiday."}},{"id":342,"category":"time","en":"Festival","hi":"त्योहार","mr":"सण","mr_roman":"san","example":{"mr":"दिवाळी मोठा सण आहे.","roman":"Diwali motha san aahe.","en":"Diwali is a big festival."}},{"id":343,"category":"time","en":"Birthday","hi":"जन्मदिन","mr":"वाढदिवस","mr_roman":"vaadhdivas","example":{"mr":"वाढदिवसाच्या शुभेच्छा!","roman":"Vaadhdivasachya shubhechha!","en":"Happy birthday!"}},{"id":344,"category":"time",