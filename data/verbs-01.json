ne","example":{"mr":"आम्ही जिंकलो!","roman":"Aamhi jinklo!","en":"We won!"}},{"id":508,"category":"verbs","en":"To lose","hi":"हारना","mr":"हरणे","mr_roman":"harne","example":{"mr":"ते हरले.","roman":"Te harle.","en":"They lost."}},{"id":509,"category":"verbs","en":"To hide","hi":"छिपना","mr":"लपणे","mr_roman":"lapne","example":{"mr":"तो लपला.","roman":"To lapla.","en":"He hid."}},{"id":510,"category":"verbs","en":"To grow / increase","hi":"बढ़ना","mr":"वाढणे","mr_roman":"vadhne","example":{"mr":"झाड वाढलं.","roman":"Jhaad vadhla.","en":"The tree grew."}},{"id":511,"category":"verbs","en":"To get / receive","hi":"मिलना","mr":"मिळणे","mr_roman":"milne","example":{"mr":"मला नोकरी मिळाली.","roman":"Mala nokri milali.","en":"I got a job."}},{"id":512,"category":"verbs","en":"To count","hi":"गिनना","mr":"मोजणे","mr_roman":"mojne","example":{"mr":"पैसे मोज.","roman":"Paise moj.","en":"Count the money."}},{"id":513,"category":"verbs","en":"To smell","hi":"सूँघना","mr":"वास घेणे","mr_roman":"vaas ghene","example":{"mr":"फुलाचा वास घे.","roman":"Phulacha vaas ghe.","en":"Smell the flower."}},{"id":514,"category":"verbs","en":"To taste","hi":"चखना","mr":"चव घेणे","mr_roman":"chav ghene","example":{"mr":"भाजीची चव घे.","roman":"Bhajichi chav ghe.","en":"Taste the vegetable."}}]