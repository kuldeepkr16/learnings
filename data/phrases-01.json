[{"id":576,"category":"phrases","en":"Hello","hi":"नमस्ते","mr":"नमस्कार","mr_roman":"namaskar","example":{"mr":"नमस्कार, कसे आहात?","roman":"Namaskar, kase aahat?","en":"Hello, how are you?"}},{"id":577,"category":"phrases","en":"Thank you","hi":"धन्यवाद","mr":"धन्यवाद","mr_roman":"dhanyavad","example":{"mr":"मदतीबद्दल धन्यवाद.","roman":"Madatibaddal dhanyavad.","en":"Thank you for the help."}},{"id":578,"category":"phrases","en":"Sorry","hi":"माफ़ कीजिए","mr":"माफ करा","mr_roman":"maaf kara","example":{"mr":"माफ करा, उशीर झाला.","roman":"Maaf kara, ushir jhala.","en":"Sorry, I got late."}},{"id":579,"category":"phrases","en":"Yes","hi":"हाँ","mr":"हो","mr_roman":"ho","example":{"mr":"हो, मी येतो.","roman":"Ho, mi yeto.","en":"Yes, I am coming."}},{"id":580,"category":"phrases","en":"No","hi":"नहीं","mr":"नाही","mr_roman":"nahi","example":{"mr":"नाही, मला नको.","roman":"Nahi, mala nako.","en":"No, I do not want it."}},{"id":581,"category":"phrases","en":"Please","hi":"कृपया","mr":"कृपया","mr_roman":"krupaya","example":{"mr":"कृपया बसा.","roman":"Krupaya basa.","en":"Please sit."}},{"id":582,"category":"phrases","en":"How are you?","hi":"आप कैसे हैं?","mr":"तुम्ही कसे आहात?","mr_roman":"Tumhi kase aahat?","example":{"mr":"तुम्ही कसे आहात? मी ठीक आहे.","roman":"Tumhi kase aahat? Mi thik aahe.","en":"How are you? I am fine."}},{"id":583,"category":"phrases","en":"I am fine","hi":"मैं ठीक हूँ","mr":"मी ठीक आहे","mr_roman":"Mi thik aahe","example":{"mr":"मी ठीक आहे, तुम्ही?","roman":"Mi thik aahe, tumhi?","en":"I am fine, and you?"}},{"id":584,"category":"phrases","en":"What is your name?","hi":"आपका नाम क्या है?","mr":"तुमचं नाव काय?","mr_roman":"Tumcha naav kay?","example":{"mr":"तुमचं नाव काय आहे?","roman":"Tumcha naav kay aahe?","en":"What is your name?"}},{"id":585,"category":"phrases","en":"My name is ...","hi":"मेरा नाम ... है","mr":"माझं नाव ... आहे","mr_roman":"Majha naav ... aahe","example":{"mr":"माझं नाव कुलदीप आहे.","roman":"Majha naav Kuldeep aahe.","en":"My name is Kuldeep."}},{"id":586,"category":"phrases","en":"Okay","hi":"ठीक है","mr":"ठीक आहे","mr_roman":"thik aahe","example":{"mr":"ठीक आहे, चला.","roman":"Thik aahe, chala.","en":"Okay, let's go."}},{"id":587,"category":"phrases","en":"Good morning","hi":"सुप्रभात","mr":"शुभ सकाळ","mr_roman":"shubh sakal","example":{"mr":"शुभ सकाळ, आई!","roman":"Shubh sakal, aai!","en":"Good morning, mother!"}},{"id":588,"category":"phrases","en":"Good night","hi":"शुभ रात्रि","mr":"शुभ रात्री","mr_roman":"shubh ratri","example":{"mr":"शुभ रात्री, उद्या भेटू.","roman":"Shubh ratri, udya bhetu.","en":"Good night, see you tomorrow."}},{"id":589,"category":"phrases","en":"Welcome","hi":"स्वागत है","mr":"स्वागत आहे","mr_roman":"swagat aahe","example":{"mr":"तुमचं स्वागत आहे.","roman":"Tumcha swagat aahe.","en":"You are welcome."}},{"id":590,"category":"phrases","en":"Let's go","hi":"चलो","mr":"चला","mr_roman":"chala","example":{"mr":"चला, निघूया.","roman":"Chala, nighuya.","en":"Come on, let's leave."}},{"id":591,"category":"phrases","en":"Come in","hi":"अंदर आइए","mr":"आत या","mr_roman":"aat ya","example":{"mr":"आत या, बसा.","roman":"Aat ya, basa.","en":"Come in, sit."}},{"id":592,"category":"phrases","en":"How much?","hi":"कितना?","mr":"किती?","mr_roman":"kiti?","example":{"mr":"हे किती रुपये?","roman":"He kiti rupaye?","en":"How much is this?"}},{"id":593,"category":"phrases","en":"Where?","hi":"कहाँ?","mr":"कुठे?","mr_roman":"kuthe?","example":{"mr":"तू कुठे आहेस?","roman":"Tu kuthe aahes?","en":"Where are you?"}},{"id":594,"category":"phrases","en":"What?","hi":"क्या?","mr":"काय?","mr_roman":"kay?","example":{"mr":"हे काय आहे?","roman":"He kay aahe?","en":"What is this?"}},{"id":595,"category":"phrases","en":"Why?","hi":"क्यों?","mr":"का?","mr_roman":"ka?","example":{"mr":"तू का रडतोस?","roman":"Tu ka radtos?","en":"Why are you crying?"}},{"id":596,"category":"phrases","en":"When?","hi":"कब?","mr":"कधी?","mr_roman":"kadhi?","example":{"mr":"तू कधी येणार?","roman":"Tu kadhi yenar?","en":"When will you come?"}},{"id":597,"category":"phrases","en":"Who?","hi":"कौन?","mr":"कोण?","mr_roman":"kon?","example":{"mr":"हे कोण आहे?","roman":"He kon aahe?","en":"Who is this?"}},{"id":598,"category":"phrases","en":"How?","hi":"कैसे?","mr":"कसं?","mr_roman":"kasa?","example":{"mr":"हे कसं करायचं?","roman":"He kasa karaycha?","en":"How to do this?"}},{"id":599,"category":"phrases","en":"Which?","hi":"कौन सा?","mr":"कोणता?","mr_roman":"konta?","example":{"mr":"कोणता रंग हवा?","roman":"Konta rang hava?","en":"Which colour do you want?"}},{"id":600,"category":"phrases","en":"I","hi":"मैं","mr":"मी","mr_roman":"mi","example":{"mr":"मी विद्यार्थी आहे.","roman":"Mi vidyarthi aahe.","en":"I am a student."}},{"id":601,"category":"phrases","en":"You (informal)","hi":"तू","mr":"तू","mr_roman":"tu","example":{"mr":"तू कुठे जातोस?","roman":"Tu kuthe jatos?","en":"Where are you going?"}},{"id":602,"category":"phrases","en":"You (formal / plural)","hi":"आप","mr":"तुम्ही","mr_roman":"tumhi","example":{"mr":"तुम्ही कुठून आलात?","roman":"Tumhi kuthun aalat?","en":"Where have you come from?"}},{"id":603,"category":"phrases","en":"He","hi":"वह","mr":"तो","mr_roman":"to","example":{"mr":"तो माझा भाऊ आहे.","roman":"To majha bhau aahe.","en":"He is my brother."}},{"id":604,"category":"phrases","en":"She","hi":"वह","mr":"ती","mr_roman":"ti","example":{"mr":"ती माझी बहीण आहे.","roman":"Ti majhi bahin aahe.","en":"She is my sister."}},{"id":605,"category":"phrases","en":"It / This (neuter)","hi":"यह","mr":"हे","mr_roman":"he","example":{"mr":"हे माझं घर आहे.","roman":"He majha ghar aahe.","en":"This is my house."}},{"id":606,"category":"phrases","en":"That","hi":"वह","mr":"ते","mr_roman":"te","example":{"mr":"ते काय आहे?","roman":"Te kay aahe?","en":"What is that?"}},{"id":607,"category":"phrases","en":"We","hi":"हम","mr":"आम्ही","mr_roman":"aamhi","example":{"mr":"आम्ही पुण्याचे आहोत.","roman":"Aamhi Punyache aahot.","en":"We are from Pune."}},{"id":608,"category":"phrases","en":"They","hi":"वे","mr":"ते","mr_roman":"te","example":{"mr":"ते उद्या येणार.","roman":"Te udya yenar.","en":"They will come tomorrow."}},{"id":609,"category":"phrases","en":"Here","hi":"यहाँ","mr":"इथे","mr_roman":"ithe","example":{"mr":"इथे बस.","roman":"Ithe bas.","en":"Sit here."}},{"id":610,"category":"phrases","en":"There","hi":"वहाँ","mr":"तिथे","mr_roman":"tithe","example":{"mr":"तिथे जा.","roman":"Tithe ja.","en":"Go there."}},{"id":611,"category":"phrases","en":"My / Mine","hi":"मेरा","mr":"माझा","mr_roman":"majha","example":{"mr":"हा माझा फोन आहे.","roman":"Ha majha phone aahe.","en":"This is my phone."}},{"id":612,"category":"phrases","en":"Your (informal)","hi":"तेरा","mr":"तुझा","mr_roman":"tujha","example":{"mr":"हे तुझं पुस्तक आहे का?","roman":"He tujha pustak aahe ka?","en":"Is this your book?"}},{"id":613,"category":"phrases","en":"Your (formal)","hi":"आपका","mr":"तुमचा","mr_roman":"tumcha","example":{"mr":"तुमचं घर कुठे आहे?","roman":"Tumcha ghar kuthe aahe?","en":"Where is your house?"}},{"id":614,"category":"phrases","en":"Water please","hi":"पानी दीजिए","mr":"पाणी द्या","mr_roman":"paani dya","example":{"mr":"कृपया पाणी द्या.","roman":"Krupaya paani dya.","en":"Please give water."}},{"id":615,"category":"phrases","en":"I don't understand","hi":"मुझे समझ नहीं आया","mr":"मला समजलं नाही","mr_roman":"Mala samajla nahi","example":{"mr":"माफ करा, मला समजलं नाही.","roman":"Maaf kara, mala samajla nahi.","en":"Sorry, I did not understand."}},{"id":616,"category":"phrases","en":"Speak slowly","hi":"धीरे बोलिए","mr":"हळू बोला","mr_roman":"halu bola","example":{"mr":"कृपया हळू बोला.","roman":"Krupaya halu bola.","en":"Please speak slowly."}},{"id":617,"category":"phrases","en":"See you again","hi":"फिर मिलेंगे","mr":"पुन्हा भेटू","mr_roman":"punha bhetu","example":{"mr":"पुन्हा भेटू, काळजी घ्या.","roman":"Punha bhetu, kalji ghya.","en":"See you again, take care."}},{"id":618,"category":"phrases","en":"Nice / Great","hi":"बढ़िया","mr":"छान","mr_roman":"chhan","example":{"mr":"खूप छान!","roman":"Khup chhan!","en":"Very nice!"}},{"id":619,"category":"phrases","en":"Enough","hi":"बस","mr":"पुरे","mr_roman":"pure","example":{"mr":"बस, पुरे झालं.","roman":"Bas, pure jhala.","en":"Enough, that's it."}},{"id":620,"category":"phrases","en":"A little","hi":"थोड़ा सा","mr":"थोडंसं","mr_roman":"thodasa","example":{"mr":"मला थोडंसं मराठी येतं.","roman":"Mala thodasa Marathi yeta.","en":"I know a little Marathi."}},{"id":621,"category":"phrases","en":"Inside","hi":"अंदर","mr":"आत","mr_roman":"aat","example":{"mr":"आत ये.","roman":"Aat ye.","en":"Come inside."}},{"id":622,"category":"phrases","en":"Outside","hi":"बाहर","mr":"बाहेर","mr_roman":"baher","example":{"mr":"बाहेर पाऊस आहे.","roman":"Baher paus aahe.","en":"It is raining outside."}},{"id":623,"category":"phrases","en":"Above / Up","hi":"ऊपर","mr":"वर","mr_roman":"var","example":{"mr":"वर बघ.","roman":"Var bagh.","en":"Look up."}},{"id":624,"category":"phrases","en":"Below / Down","hi":"नीचे","mr":"खाली","mr_roman":"khali","example":{"mr":"खाली बस.","roman":"Khali bas.","en":"Sit down."}},{"id":625,"category":"phrases","en":"In front","hi":"सामने","mr":"समोर","mr_roman":"samor","example":{"mr":"समोर बघ.","roman":"Samor bagh.","en":"Look in front."}},{"id":626,"category":"phrases","en":"Behind","hi":"पीछे","mr":"मागे","mr_roman":"mage","example":{"mr":"मागे वळ.","roman":"Mage val.","en":"Turn back."}},{"id":627,"category":"phrases","en":"Left","hi":"बाएँ","mr":"डावीकडे","mr_roman":"davikade","example":{"mr":"डावीकडे वळ.","roman":"Davikade val.","en":"Turn left."}},{"id":628,"category":"phrases","en":"Right (direction)","hi":"दाएँ","mr":"उजवीकडे","mr_roman":"ujavikade","example":{"mr":"उजवीकडे वळ.","roman":"Ujavikade val.","en":"Turn right."}},{"id":629,"category":"phrases","en":"Straight","hi":"सीधा","mr":"सरळ","mr_roman":"saral","example":{"mr":"सरळ जा.","roman":"Saral ja.","en":"Go straight."}},{"id":630,"category":"phrases","en":"Take care","hi":"ख़याल रखना","mr":"काळजी घ्या","mr_roman":"kalji ghya","example":{"mr":"काळजी घ्या.","roman":"Kalji ghya.","en":"Take care."}},{"id":631,"category":"phrases","en":"Congratulations","hi":"बधाई हो","mr":"अभिनंदन","mr_roman":"abhinandan","example":{"mr":"अभिनंदन!","roman":"Abhinandan!","en":"Congratulations!"}},{"id":632,"category":"phrases","en":"Happy Diwali","hi":"दिवाली की शुभकामनाएँ","mr":"दिवाळीच्या शुभेच्छा","mr_roman":"Diwalichya shubhechha","example":{"mr":"दिवाळीच्या हार्दिक शुभेच्छा!","roman":"Diwalichya hardik shubhechha!","en":"Heartfelt Diwali wishes!"}},{"id":633,"category":"phrases","en":"What happened?","hi":"क्या हुआ?","mr":"काय झालं?","mr_roman":"Kay jhala?","example":{"mr":"काय झालं? ठीक आहेस ना?","roman":"Kay jhala? Thik aahes na?","en":"What happened? Are you okay?"}},{"id":634,"category":"phrases","en":"No problem","hi":"कोई बात नहीं","mr":"काही हरकत नाही","mr_roman":"kahi harkat nahi","example":{"mr":"काही हरकत नाही.","roman":"Kahi harkat nahi.","en":"No problem."}},{"id":635,"category":"phrases","en":"Of course","hi":"ज़रूर","mr":"नक्कीच","mr_roman":"nakkich","example":{"mr":"नक्कीच, मी येईन.","roman":"Nakkich, mi yein.","en":"Of course, I will come."}},{"id":636,"category":"phrases","en":"Maybe","hi":"शायद","mr":"कदाचित","mr_roman":"kadachit","example":{"mr":"कदाचित उद्या पाऊस पडेल.","roman":"Kadachit udya paus padel.","en":"Maybe it will rain tomorrow."}},{"id":637,"category":"phrases","en":"Really?","hi":"सच में?","mr":"खरंच?","mr_roman":"kharach?","example":{"mr":"खरंच? छान!","roman":"Kharach? Chhan!","en":"Really? Great!"}},{"id":638,"category":"phrases","en":"I am hungry","hi":"मुझे भूख लगी है","mr":"मला भूक लागली आहे","mr_roman":"Mala bhuk lagli aahe","example":{"mr":"मला भूक लागली आहे, जेवूया.","roman":"Mala bhuk lagli aahe, jevuya.","en":"I am hungry, let's eat."}},{"id":639,"category":"phrases","en":"Where are you going?","hi":"कहाँ जा रहे हो?","mr":"कुठे चाललास?","mr_roman":"Kuthe challas?","example":{"mr":"कुठे चाललास? मी पण येतो.","roman":"Kuthe challas? Mi pan yeto.","en":"Where are you going? I will also come."}},{"id":640,"category":"phrases","en":"Did you eat?","hi":"खाना खाया?","mr":"जेवलास का?","mr_roman":"Jevlas ka?","example":{"mr":"जेवलास का? नाही तर जेवून घे.","roman":"Jevlas ka? Nahi tar jevun ghe.","en":"Did you eat? If not, eat."}},{"id":641,"category":"phrases","en":"I like it","hi":"मुझे पसंद है","mr":"मला आवडलं","mr_roman":"Mala aavadla","example":{"mr":"मला हे खूप आवडलं.","roman":"Mala he khup aavadla.","en":"I liked this a lot."}},{"id":642,"category":"phrases","en":"Wait a minute","hi":"एक मिनट रुको","mr":"एक मिनिट थांब","mr_roman":"Ek minit thamb","example":{"mr":"एक मिनिट थांब, मी आलोच.","roman":"Ek minit thamb, mi aaloch.","en":"Wait a minute, I'll be right back."}},{"id":643,"category":"phrases","en":"How much is this?","hi":"यह कितने का है?","mr":"हे किती ला?","mr_roman":"He kiti la?","example":{"mr":"हे किती ला दिलं?","roman":"He kiti la dila?","en":"For how much did you get this?"}},{"id":644,"category":"phrases","en":"Give me that","hi":"वह दो","mr":"ते दे","mr_roman":"te de","example":{"mr":"ते मला दे.","roman":"Te mala de.","en":"Give that to me."}},{"id":645,"category":"phrases","en":"I don't want","hi":"मुझे नहीं चाहिए","mr":"मला नको","mr_roman":"mala nako","example":{"mr":"मला चहा नको.","roman":"Mala chaha nako.","en":"I don't want tea."}},{"id":646,"category":"phrases","en":"I want","hi":"मुझे चाहिए","mr":"मला हवं","mr_roman":"mala hava","example":{"mr":"मला पाणी हवं.","roman":"Mala paani hava.","en":"I want water."}},{"id":647,"category":"phrases","en":"Is it so?","hi":"ऐसा है क्या?","mr":"असं का?","mr_roman":"asa ka?","example":{"mr":"असं का? मला माहीत नव्हतं.","roman":"Asa ka? Mala mahit navhta.","en":"Is that so? I did not know."}},{"id":648,"category":"phrases","en":"Let it be","hi":"रहने दो","mr":"राहू दे","mr_roman":"rahu de","example":{"mr":"राहू दे, काही हरकत नाही.","roman":"Rahu de, kahi harkat nahi.","en":"Let it be, no problem."}},{"id":649,"category":"phrases","en":"Come quickly","hi":"जल्दी आओ","mr":"लवकर ये","mr_roman":"lavkar ye","example":{"mr":"लवकर ये, उशीर होतोय.","roman":"Lavkar ye, ushir hotoy.","en":"Come quickly, it is getting late."}},{"id":650,"category":"phrases","en":"Very good","hi":"बहुत अच्छा","mr":"खूप छान","mr_roman":"khup chhan","example":{"mr":"खूप छान काम केलंस.","roman":"Khup chhan kaam kelas.","en":"You did very good work."}},{"id":651,"category":"phrases","en":"And","hi":"और","mr":"आणि","mr_roman":"aani","example":{"mr":"चहा आणि पोहे.","roman":"Chaha aani pohe.","en":"Tea and poha."}},{"id":652,"category":"phrases","en":"But","hi":"लेकिन","mr":"पण","mr_roman":"pan","example":{"mr":"मी येईन, पण उशिरा.","roman":"Mi yein, pan ushira.","en":"I will come, but late."}},{"id":653,"category":"phrases","en":"Because","hi":"क्योंकि","mr":"कारण","mr_roman":"karan","example":{"mr":"मी थांबलो कारण पाऊस होता.","roman":"Mi thamblo karan paus hota.","en":"I stopped because it was raining."}},{"id":654,"category":"phrases","en":"With","hi":"के साथ","mr":"सोबत","mr_roman":"sobat","example":{"mr":"माझ्यासोबत ये.","roman":"Majhyasobat ye.","en":"Come with me."}},{"id":655,"category":"phrases","en":"Without","hi":"के बिना","mr":"शिवाय","mr_roman":"shivay","example":{"mr":"साखरेशिवाय चहा.","roman":"Sakhareshivay chaha.","en":"Tea without sugar."}},{"id":656,"category":"phrases","en":"Only","hi":"सिर्फ़","mr":"फक्त","mr_roman":"phakta","example":{"mr":"फक्त एक मिनिट.","roman":"Phakta ek minit.","en":"Only one minute."}},{"id":657,"category":"phrases","en":"Also","hi":"भी","mr":"पण / सुद्धा","mr_roman":"pan / suddha","example":{"mr":"मी पण येतो.","roman":"Mi pan yeto.","en":"I am also coming."}},{"id":658,"category":"phrases","en":"Again","hi":"फिर से","mr":"पुन्हा","mr_roman":"punha","example":{"mr":"पुन्हा सांग.","roman":"Punha sang.","en":"Say it again."}},{"id":659,"category":"phrases","en":"Now (right away)","hi":"अभी","mr":"आत्ता","mr_roman":"aatta","example":{"mr":"आत्ता लगेच ये.","roman":"Aatta lagech ye.","en":"Come right now."}},{"id":660,"category":"phrases","en":"Slowly","hi":"धीरे","mr":"हळूहळू","mr_roman":"haluhalu","example":{"mr":"हळूहळू शिक.","roman":"Haluhalu shik.","en":"Learn slowly."}},{"id":661,"category":"phrases","en":"Quickly","hi":"जल्दी","mr":"पटकन","mr_roman":"patkan","example":{"mr":"पटकन कर.","roman":"Patkan kar.","en":"Do it quickly."}}]