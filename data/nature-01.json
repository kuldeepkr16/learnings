[{"id":345,"category":"nature","en":"Sun","hi":"सूरज","mr":"सूर्य","mr_roman":"surya","example":{"mr":"सूर्य उगवला.","roman":"Surya ugavla.","en":"The sun has risen."}},{"id":346,"category":"nature","en":"Moon","hi":"चाँद","mr":"चंद्र","mr_roman":"chandra","example":{"mr":"आज चंद्र पूर्ण आहे.","roman":"Aaj chandra purna aahe.","en":"The moon is full today."}},{"id":347,"category":"nature","en":"Star","hi":"तारा","mr":"तारा","mr_roman":"tara","example":{"mr":"आकाशात तारे चमकतात.","roman":"Aakashat tare chamaktat.","en":"Stars shine in the sky."}},{"id":348,"category":"nature","en":"Sky","hi":"आसमान","mr":"आकाश","mr_roman":"aakash","example":{"mr":"आकाश निळं आहे.","roman":"Aakash nila aahe.","en":"The sky is blue."}},{"id":349,"category":"nature","en":"Rain","hi":"बारिश","mr":"पाऊस","mr_roman":"paus","example":{"mr":"पाऊस पडतोय.","roman":"Paus padtoy.","en":"It is raining."}},{"id":350,"category":"nature","en":"Wind","hi":"हवा","mr":"वारा","mr_roman":"vara","example":{"mr":"वारा सुटला आहे.","roman":"Vara sutla aahe.","en":"The wind is blowing."}},{"id":351,"category":"nature","en":"Cloud","hi":"बादल","mr":"ढग","mr_roman":"dhag","example":{"mr":"आकाशात ढग आहेत.","roman":"Aakashat dhag aahet.","en":"There are clouds in the sky."}},{"id":352,"category":"nature","en":"Tree","hi":"पेड़","mr":"झाड","mr_roman":"jhaad","example":{"mr":"झाड मोठं आहे.","roman":"Jhaad motha aahe.","en":"The tree is big."}},{"id":353,"category":"nature","en":"Flower","hi":"फूल","mr":"फूल","mr_roman":"phul","example":{"mr":"फूल सुंदर आहे.","roman":"Phul sundar aahe.","en":"The flower is beautiful."}},{"id":354,"category":"nature","en":"Leaf","hi":"पत्ता","mr":"पान","mr_roman":"paan","example":{"mr":"पान हिरवं आहे.","roman":"Paan hirva aahe.","en":"The leaf is green."}},{"id":355,"category":"nature","en":"River","hi":"नदी","mr":"नदी","mr_roman":"nadi","example":{"mr":"नदी वाहते.","roman":"Nadi vahte.","en":"The river flows."}},{"id":356,"category":"nature","en":"Sea","hi":"समुद्र","mr":"समुद्र","mr_roman":"samudra","example":{"mr":"समुद्र खूप मोठा आहे.","roman":"Samudra khup motha aahe.","en":"The sea is very big."}},{"id":357,"category":"nature","en":"Mountain","hi":"पहाड़","mr":"डोंगर","mr_roman":"dongar","example":{"mr":"डोंगरावर चढू.","roman":"Dongaravar chadhu.","en":"Let's climb the mountain."}},{"id":358,"category":"nature","en":"Stone","hi":"पत्थर","mr":"दगड","mr_roman":"dagad","example":{"mr":"दगड जड आहे.","roman":"Dagad jad aahe.","en":"The stone is heavy."}},{"id":359,"category":"nature","en":"Soil / Mud","hi":"मिट्टी","mr":"माती","mr_roman":"mati","example":{"mr":"माती ओली आहे.","roman":"Mati oli aahe.","en":"The soil is wet."}},{"id":360,"category":"nature","en":"Ground / Land","hi":"ज़मीन","mr":"जमीन","mr_roman":"jamin","example":{"mr":"जमिनीवर बस.","roman":"Jaminivar bas.","en":"Sit on the ground."}},{"id":361,"category":"nature","en":"Cold (weather)","hi":"ठंड","mr":"थंडी","mr_roman":"thandi","example":{"mr":"आज खूप थंडी आहे.","roman":"Aaj khup thandi aahe.","en":"It is very cold today."}},{"id":362,"category":"nature","en":"Sunshine / Heat","hi":"धूप","mr":"ऊन","mr_roman":"unh","example":{"mr":"ऊन खूप आहे.","roman":"Unh khup aahe.","en":"It is very sunny."}},{"id":363,"category":"nature","en":"Summer","hi":"गर्मी","mr":"उन्हाळा","mr_roman":"unhala","example":{"mr":"उन्हाळ्यात आंबे येतात.","roman":"Unhalyat aambe yetat.","en":"Mangoes come in summer."}},{"id":364,"category":"nature","en":"Winter","hi":"सर्दी","mr":"हिवाळा","mr_roman":"hivala","example":{"mr":"हिवाळ्यात थंडी असते.","roman":"Hivalyat thandi aste.","en":"It is cold in winter."}},{"id":365,"category":"nature","en":"Monsoon","hi":"बरसात","mr":"पावसाळा","mr_roman":"pavsala","example":{"mr":"पावसाळ्यात छत्री लागते.","roman":"Pavsalyat chhatri lagte.","en":"An umbrella is needed in monsoon."}},{"id":366,"category":"nature","en":"Light","hi":"रोशनी","mr":"प्रकाश","mr_roman":"prakash","example":{"mr":"खोलीत प्रकाश आहे.","roman":"Kholit prakash aahe.","en":"There is light in the room."}},{"id":367,"category":"nature","en":"Darkness","hi":"अंधेरा","mr":"अंधार","mr_roman":"andhar","example":{"mr":"बाहेर अंधार आहे.","roman":"Baher andhar aahe.","en":"It is dark outside."}},{"id":368,"category":"nature","en":"Dust","hi":"धूल","mr":"धूळ","mr_roman":"dhul","example":{"mr":"रस्त्यावर धूळ आहे.","roman":"Rastyavar dhul aahe.","en":"There is dust on the road."}},{"id":369,"category":"nature","en":"Grass","hi":"घास","mr":"गवत","mr_roman":"gavat","example":{"mr":"गवत हिरवं आहे.","roman":"Gavat hirva aahe.","en":"The grass is green."}},{"id":370,"category":"nature","en":"Forest","hi":"जंगल","mr":"जंगल","mr_roman":"jangal","example":{"mr":"जंगलात वाघ असतात.","roman":"Jangalat vagh astat.","en":"There are tigers in the forest."}},{"id":371,"category":"nature","en":"Lake","hi":"झील","mr":"तलाव","mr_roman":"talav","example":{"mr":"तलावात मासे आहेत.","roman":"Talavat mase aahet.","en":"There are fish in the lake."}},{"id":372,"category":"nature","en":"Well","hi":"कुआँ","mr":"विहीर","mr_roman":"vihir","example":{"mr":"विहिरीत पाणी आहे.","roman":"Vihirit paani aahe.","en":"There is water in the well."}},{"id":373,"category":"nature","en":"Field / Farm","hi":"खेत","mr":"शेत","mr_roman":"shet","example":{"mr":"शेतकरी शेतात काम करतो.","roman":"Shetkari shetat kaam karto.","en":"The farmer works in the field."}},{"id":374,"category":"nature","en":"Sand","hi":"रेत","mr":"वाळू","mr_roman":"valu","example":{"mr":"समुद्रकिनारी वाळू आहे.","roman":"Samudrakinari valu aahe.","en":"There is sand on the beach."}}]