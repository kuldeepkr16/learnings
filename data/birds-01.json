[{"id":662,"category":"birds","en":"Eagle","hi":"गरुड़","mr":"गरुड","mr_roman":"garud","example":{"mr":"गरुड आकाशात उडतो.","roman":"Garud akashat udto.","en":"The eagle flies in the sky."}},{"id":663,"category":"birds","en":"Owl","hi":"उल्लू","mr":"घुबड","mr_roman":"ghubad","example":{"mr":"घुबड रात्री जागं असतं.","roman":"Ghubad ratri jaga asta.","en":"The owl is awake at night."}},{"id":664,"category":"birds","en":"Duck","hi":"बत्तख","mr":"बदक","mr_roman":"badak","example":{"mr":"बदक पाण्यात पोहतं.","roman":"Badak panyat pohata.","en":"The duck swims in the water."}},{"id":665,"category":"birds","en":"Swan","hi":"हंस","mr":"हंस","mr_roman":"hans","example":{"mr":"हंस तलावात पोहतो.","roman":"Hans talavat pohato.","en":"The swan swims in the lake."}},{"id":666,"category":"birds","en":"Cuckoo","hi":"कोयल","mr":"कोकिळा","mr_roman":"kokila","example":{"mr":"कोकिळा गोड गाते.","roman":"Kokila god gate.","en":"The cuckoo sings sweetly."}},{"id":667,"category":"birds","en":"Myna","hi":"मैना","mr":"मैना","mr_roman":"maina","example":{"mr":"मैना झाडावर बसली आहे.","roman":"Maina jhadavar basali aahe.","en":"The myna is sitting on the tree."}},{"id":668,"category":"birds","en":"Vulture","hi":"गिद्ध","mr":"गिधाड","mr_roman":"gidhad","example":{"mr":"गिधाड उंच उडतं.","roman":"Gidhad uncha udata.","en":"The vulture flies high."}},{"id":669,"category":"birds","en":"Woodpecker","hi":"कठफोड़वा","mr":"सुतारपक्षी","mr_roman":"sutar-pakshi","example":{"mr":"सुतारपक्षी झाडावर चोच मारतो.","roman":"Sutar-pakshi jhadavar choch marato.","en":"The woodpecker pecks the tree."}},{"id":670,"category":"birds","en":"Kingfisher","hi":"किंगफ़िशर","mr":"खंड्या","mr_roman":"khandya","example":{"mr":"खंड्या पाण्याजवळ बसला आहे.","roman":"Khandya panyajaval basala aahe.","en":"The kingfisher is sitting near the water."}},{"id":671,"category":"birds","en":"Crane","hi":"सारस","mr":"बगळा","mr_roman":"bagala","example":{"mr":"बगळा पाण्यात उभा आहे.","roman":"Bagala panyat ubha aahe.","en":"The crane is standing in the water."}},{"id":672,"category":"birds","en":"Ostrich","hi":"शुतुरमुर्ग","mr":"शहामृग","mr_roman":"shahamrug","example":{"mr":"शहामृग वेगाने धावतो.","roman":"Shahamrug vegane dhavato.","en":"The ostrich runs fast."}},{"id":673,"category":"birds","en":"Penguin","hi":"पेंगुइन","mr":"पेंग्विन","mr_roman":"pengvin","example":{"mr":"पेंग्विन थंड प्रदेशात राहतो.","roman":"Pengvin thand pradeshat rahato.","en":"The penguin lives in a cold region."}}]