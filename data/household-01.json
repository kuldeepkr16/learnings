[{"id":687,"category":"household","en":"Sofa","hi":"सोफ़ा","mr":"सोफा","mr_roman":"sofa","example":{"mr":"सोफा दिवाणखान्यात आहे.","roman":"Sofa divankhanyat aahe.","en":"The sofa is in the living room."}},{"id":688,"category":"household","en":"Mattress","hi":"गद्दा","mr":"गादी","mr_roman":"gadi","example":{"mr":"गादी मऊ आहे.","roman":"Gadi mau aahe.","en":"The mattress is soft."}},{"id":689,"category":"household","en":"Bedsheet","hi":"चादर","mr":"चादर","mr_roman":"chadar","example":{"mr":"चादर पलंगावर घाल.","roman":"Chadar palangavar ghal.","en":"Put the bedsheet on the bed."}},{"id":690,"category":"household","en":"Drawer","hi":"दराज़","mr":"खण","mr_roman":"khan","example":{"mr":"किल्ली खणात ठेव.","roman":"Killi khanat thev.","en":"Keep the key in the drawer."}},{"id":691,"category":"household","en":"Doorbell","hi":"दरवाज़े की घंटी","mr":"दाराची घंटी","mr_roman":"darachi ghanti","example":{"mr":"दाराची घंटी वाजली.","roman":"Darachi ghanti vajali.","en":"The doorbell rang."}},{"id":692,"category":"household","en":"Doormat","hi":"पायदान","mr":"पायपुसणी","mr_roman":"paypusani","example":{"mr":"पाय पायपुसणीवर पुस.","roman":"Paay paypusanivar pus.","en":"Wipe your feet on the doormat."}},{"id":693,"category":"household","en":"Mosquito net","hi":"मच्छरदानी","mr":"मच्छरदाणी","mr_roman":"machchhardani","example":{"mr":"रात्री मच्छरदाणी लाव.","roman":"Ratri machchhardani lav.","en":"Put up the mosquito net at night."}},{"id":694,"category":"household","en":"Clothes hanger","hi":"कपड़ों का हैंगर","mr":"कपड्यांचा हँगर","mr_roman":"kapadyancha hanger","example":{"mr":"शर्ट हँगरवर टांग.","roman":"Shirt hangervar tang.","en":"Hang the shirt on the hanger."}},{"id":695,"category":"household","en":"Iron","hi":"इस्त्री","mr":"इस्त्री","mr_roman":"istri","example":{"mr":"इस्त्री गरम आहे.","roman":"Istri garam aahe.","en":"The iron is hot."}},{"id":696,"category":"household","en":"Washing machine","hi":"कपड़े धोने की मशीन","mr":"कपडे धुण्याचं यंत्र","mr_roman":"kapade dhunyacha yantra","example":{"mr":"कपडे यंत्रात टाक.","roman":"Kapade yantrat tak.","en":"Put the clothes in the washing machine."}},{"id":697,"category":"household","en":"Air conditioner","hi":"वातानुकूलक","mr":"वातानुकूलक","mr_roman":"vatanukulak","example":{"mr":"वातानुकूलक चालू कर.","roman":"Vatanukulak chalu kar.","en":"Turn on the air conditioner."}},{"id":698,"category":"household","en":"Remote control","hi":"रिमोट कंट्रोल","mr":"रिमोट कंट्रोल","mr_roman":"remote control","example":{"mr":"रिमोट टेबलावर आहे.","roman":"Remote tablevar aahe.","en":"The remote control is on the table."}},{"id":699,"category":"household","en":"Basket","hi":"टोकरी","mr":"टोपली","mr_roman":"topali","example":{"mr":"फळं टोपलीत ठेव.","roman":"Phala topalit thev.","en":"Keep the fruit in the basket."}}]