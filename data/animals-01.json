id":686,"category":"animals","en":"Crocodile","hi":"मगरमच्छ","mr":"मगर","mr_roman":"magar","example":{"mr":"मगर नदीत पोहते.","roman":"Magar nadit pohate.","en":"The crocodile swims in the river."}}]