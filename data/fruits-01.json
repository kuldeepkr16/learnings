[{"id":152,"category":"fruits","en":"Fruit","hi":"फल","mr":"फळ","mr_roman":"phal","example":{"mr":"रोज एक फळ खा.","roman":"Roj ek phal kha.","en":"Eat one fruit every day."}},{"id":153,"category":"fruits","en":"Mango","hi":"आम","mr":"आंबा","mr_roman":"aamba","example":{"mr":"आंबा गोड आहे.","roman":"Aamba god aahe.","en":"The mango is sweet."}},{"id":154,"category":"fruits","en":"Banana","hi":"केला","mr":"केळं","mr_roman":"kela","example":{"mr":"केळी स्वस्त आहेत.","roman":"Keli swast aahet.","en":"Bananas are cheap."}},{"id":155,"category":"fruits","en":"Apple","hi":"सेब","mr":"सफरचंद","mr_roman":"sapharchand","example":{"mr":"सफरचंद लाल आहे.","roman":"Sapharchand lal aahe.","en":"The apple is red."}},{"id":156,"category":"fruits","en":"Orange","hi":"संतरा","mr":"संत्रं","mr_roman":"santra","example":{"mr":"संत्रं आंबट आहे.","roman":"Santra aambat aahe.","en":"The orange is sour."}},{"id":157,"category":"fruits","en":"Grapes","hi":"अंगूर","mr":"द्राक्षं","mr_roman":"draksha","example":{"mr":"द्राक्षं गोड आहेत.","roman":"Draksha god aahet.","en":"The grapes are sweet."}},{"id":158,"category":"fruits","en":"Guava","hi":"अमरूद","mr":"पेरू","mr_roman":"peru","example":{"mr":"पेरू कच्चा आहे.","roman":"Peru kachcha aahe.","en":"The guava is raw."}},{"id":159,"category":"fruits","en":"Papaya","hi":"पपीता","mr":"पपई","mr_roman":"papai","example":{"mr":"पपई पिकली आहे.","roman":"Papai pikli aahe.","en":"The papaya is ripe."}},{"id":160,"category":"fruits","en":"Pomegranate","hi":"अनार","mr":"डाळिंब","mr_roman":"dalimb","example":{"mr":"डाळिंब सोल.","roman":"Dalimb sol.","en":"Peel the pomegranate."}},{"id":161,"category":"fruits","en":"Watermelon","hi":"तरबूज़","mr":"कलिंगड","mr_roman":"kalingad","example":{"mr":"उन्हाळ्यात कलिंगड खा.","roman":"Unhalyat kalingad kha.","en":"Eat watermelon in summer."}},{"id":162,"category":"fruits","en":"Custard apple","hi":"शरीफ़ा","mr":"सीताफळ","mr_roman":"sitaphal","example":{"mr":"सीताफळ गोड आहे.","roman":"Sitaphal god aahe.","en":"The custard apple is sweet."}},{"id":163,"category":"fruits","en":"Jackfruit","hi":"कटहल","mr":"फणस","mr_roman":"phanas","example":{"mr":"फणस मोठा आहे.","roman":"Phanas motha aahe.","en":"The jackfruit is big."}},{"id":164,"category":"fruits","en":"Chikoo","hi":"चीकू","mr":"चिकू","mr_roman":"chiku","example":{"mr":"चिकू मऊ आहे.","roman":"Chiku mau aahe.","en":"The chikoo is soft."}},{"id":165,"category":"fruits","en":"Pineapple","hi":"अनानास","mr":"अननस","mr_roman":"ananas","example":{"mr":"अननस काप.","roman":"Ananas kaap.","en":"Cut the pineapple."}},{"id":166,"category":"fruits","en":"Jamun","hi":"जामुन","mr":"जांभूळ","mr_roman":"jambhul","example":{"mr":"जांभूळ जांभळं असतं.","roman":"Jambhul jambhla asta.","en":"Jamun is purple."}},{"id":167,"category":"fruits","en":"Dates","hi":"खजूर","mr":"खजूर","mr_roman":"khajur","example":{"mr":"खजूर गोड असतात.","roman":"Khajur god astat.","en":"Dates are sweet."}},{"id":168,"category":"fruits","en":"Cashew","hi":"काजू","mr":"काजू","mr_roman":"kaju","example":{"mr":"काजू महाग आहेत.","roman":"Kaju mahag aahet.","en":"Cashews are expensive."}},{"id":169,"category":"fruits","en":"Almond","hi":"बादाम","mr":"बदाम","mr_roman":"badam","example":{"mr":"रोज बदाम खा.","roman":"Roj badam kha.","en":"Eat almonds every day."}},{"id":170,"category":"fruits","en":"Sweet lime","hi":"मौसमी","mr":"मोसंबी","mr_roman":"mosambi","example":{"mr":"मोसंबीचा रस दे.","roman":"Mosambicha ras de.","en":"Give sweet lime juice."}},{"id":171,"category":"fruits","en":"Strawberry","hi":"स्ट्रॉबेरी","mr":"स्ट्रॉबेरी","mr_roman":"strawberry","example":{"mr":"महाबळेश्वरची स्ट्रॉबेरी प्रसिद्ध आहे.","roman":"Mahabaleshwarchi strawberry prasiddha aahe.","en":"Mahabaleshwar's strawberries are famous."}}]