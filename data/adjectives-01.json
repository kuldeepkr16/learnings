ory":"adjectives","en":"Happy","hi":"खुश","mr":"आनंदी","mr_roman":"aanandi","example":{"mr":"मी आनंदी आहे.","roman":"Mi aanandi aahe.","en":"I am happy."}},{"id":549,"category":"adjectives","en":"Sad","hi":"दुखी","mr":"दुःखी","mr_roman":"dukhi","example":{"mr":"ती दुःखी आहे.","roman":"Ti dukhi aahe.","en":"She is sad."}},{"id":550,"category":"adjectives","en":"Tired","hi":"थका हुआ","mr":"थकलेला","mr_roman":"thaklela","example":{"mr":"मी थकलो.","roman":"Mi thaklo.","en":"I am tired."}},{"id":551,"category":"adjectives","en":"Hungry","hi":"भूखा","mr":"भुकेलेला","mr_roman":"bhukelela","example":{"mr":"मूल भुकेलेलं आहे.","roman":"Mul bhukelela aahe.","en":"The child is hungry."}},{"id":552,"category":"adjectives","en":"Thirsty","hi":"प्यासा","mr":"तहानलेला","mr_roman":"tahanlela","example":{"mr":"मी तहानलेलो आहे.","roman":"Mi tahanlelo aahe.","en":"I am thirsty."}},{"id":553,"category":"adjectives","en":"Easy","hi":"आसान","mr":"सोपं","mr_roman":"sopa","example":{"mr":"मराठी सोपं आहे.","roman":"Marathi sopa aahe.","en":"Marathi is easy."}},{"id":554,"category":"adjectives","en":"Difficult","hi":"मुश्किल","mr":"कठीण","mr_roman":"kathin","example":{"mr":"प्रश्न कठीण आहे.","roman":"Prashna kathin aahe.","en":"The question is difficult."}},{"id":555,"category":"adjectives","en":"Strong","hi":"मज़बूत","mr":"मजबूत","mr_roman":"majbut","example":{"mr":"दोरी मजबूत आहे.","roman":"Dori majbut aahe.","en":"The rope is strong."}},{"id":556,"category":"adjectives","en":"Weak","hi":"कमज़ोर","mr":"अशक्त","mr_roman":"ashakta","example":{"mr":"तो अशक्त आहे.","roman":"To ashakta aahe.","en":"He is weak."}},{"id":557,"category":"adjectives","en":"Rich","hi":"अमीर","mr":"श्रीमंत","mr_roman":"shrimant","example":{"mr":"तो श्रीमंत आहे.","roman":"To shrimant aahe.","en":"He is rich."}},{"id":558,"category":"adjectives","en":"Poor","hi":"ग़रीब","mr":"गरीब","mr_roman":"garib","example":{"mr":"तो गरीब आहे.","roman":"To garib aahe.","en":"He is poor."}},{"id":559,"category":"adjectives","en":"Young","hi":"जवान","mr":"तरुण","mr_roman":"tarun","example":{"mr":"तो तरुण आहे.","roman":"To tarun aahe.","en":"He is young."}},{"id":560,"category":"adjectives","en":"Old (person)","hi":"बूढ़ा","mr":"म्हातारा","mr_roman":"mhatara","example":{"mr":"आजोबा म्हातारे झाले.","roman":"Ajoba mhatare jhale.","en":"Grandfather has grown old."}},{"id":561,"category":"adjectives","en":"Wet","hi":"गीला","mr":"ओला","mr_roman":"ola","example":{"mr":"कपडे ओले आहेत.","roman":"Kapde ole aahet.","en":"The clothes are wet."}},{"id":562,"category":"adjectives","en":"Dry","hi":"सूखा","mr":"कोरडा","mr_roman":"korda","example":{"mr":"कपडे कोरडे झाले.","roman":"Kapde korde jhale.","en":"The clothes have dried."}},{"id":563,"category":"adjectives","en":"Soft","hi":"मुलायम","mr":"मऊ","mr_roman":"mau","example":{"mr":"उशी मऊ आहे.","roman":"Ushi mau aahe.","en":"The pillow is soft."}},{"id":564,"category":"adjectives","en":"Hard","hi":"कठोर","mr":"कडक","mr_roman":"kadak","example":{"mr":"पोळी कडक झाली.","roman":"Poli kadak jhali.","en":"The roti became hard."}},{"id":565,"category":"adjectives","en":"Open","hi":"खुला","mr":"उघडा","mr_roman":"ughda","example":{"mr":"दार उघडं आहे.","roman":"Daar ughda aahe.","en":"The door is open."}},{"id":566,"category":"adjectives","en":"Closed","hi":"बंद","mr":"बंद","mr_roman":"band","example":{"mr":"दुकान बंद आहे.","roman":"Dukan band aahe.","en":"The shop is closed."}},{"id":567,"category":"adjectives","en":"Same","hi":"एक जैसा","mr":"सारखा","mr_roman":"sarkha","example":{"mr":"दोन्ही सारखे आहेत.","roman":"Donhi sarkhe aahet.","en":"Both are the same."}},{"id":568,"category":"adjectives","en":"Different","hi":"अलग","mr":"वेगळा","mr_roman":"vegla","example":{"mr":"हे वेगळं आहे.","roman":"He vegla aahe.","en":"This is different."}},{"id":569,"category":"adjectives","en":"Ready","hi":"तैयार","mr":"तयार","mr_roman":"tayar","example":{"mr":"जेवण तयार आहे.","roman":"Jevan tayar aahe.","en":"Food is ready."}},{"id":570,"category":"adjectives","en":"Busy","hi":"व्यस्त